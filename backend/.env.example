ENVIRONMENT=production
CORS_ORIGINS=*
RATE_LIMIT_PER_MINUTE=60
PRO_BETA_ENABLED=true

# Authentication
# Generate a long random value in production; never commit the real secret.
SESSION_SECRET=
# Web OAuth client ID used by Android Google Sign-In and backend ID-token verification.
GOOGLE_CLIENT_ID=

# Google Play subscription verification
ANDROID_PACKAGE_NAME=com.synapsex.robotics.robolab_x
# Full service-account JSON stored only as a server-side secret.
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=

# AI provider. Keep all provider credentials on the backend only.
AI_PROVIDER=local
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=

# Optional specialist model routing overrides.
ARCHITECT_MODEL=
CIRCUIT_MODEL=
CODE_MODEL=
CAD_MODEL=
VERIFIER_MODEL=
COMPILER_MODEL=
AUDITOR_MODEL=
